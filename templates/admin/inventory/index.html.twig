{% extends 'PrestaShopBundle:Admin:layout.html.twig' %}

{% block content %}
<style>
.section-separator { border: 0; border-top: 1px solid #e0e0e0; margin: 24px 0; }
</style>
<div class="panel">
    <form action="{{ path('admin_updatestock_index') }}" method="post" enctype="multipart/form-data" class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-lg-3"><strong>{{ t.translate('Select File(s)') }}</strong></label>
            <div class="col-lg-6">
                <input type="file" name="stock_files[]" multiple accept=".txt" class="form-control">
                <p class="help-block">{{ t.translate('Format: EAN;;;;; (txt files only)') }}</p>
            </div>
            <div class="col-lg-3">
                <button type="submit" name="submitStockUpload" class="btn btn-primary">
                    <i class="process-icon-save"></i> {{ t.translate('Upload') }}
                </button>
            </div>
        </div>
    </form>
</div>

<hr class="section-separator">

<form action="{{ path('admin_updatestock_index') }}" method="post" class="form-horizontal">
    <div class="panel">
        <div class="panel-heading">
            <i class="icon-list"></i> <strong>{{ t.translate('Uploaded Files') }}</strong>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th width="40"><input type="checkbox" name="checkmeable" class="checkmeable"></th>
                    <th>{{ t.translate('Filename') }}</th>
                    <th>{{ t.translate('Size') }}</th>
                    <th>{{ t.translate('Date') }}</th>
                    <th class="text-right">{{ t.translate('Actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% if uploaded_files is not empty %}
                    {% for file in uploaded_files %}
                        <tr>
                            <td><input type="checkbox" name="selected_files[]" value="{{ file.name }}" {% if selected_files is defined and file.name in selected_files %}checked{% endif %}></td>
                            <td>{{ file.name }}</td>
                            <td>{{ file.size }} bytes</td>
                            <td>{{ file.date }}</td>
                            <td class="text-right">
                                <a href="{{ module_dir }}temp_files/{{ file.name }}" class="btn btn-default btn-xs" target="_blank">
                                    <i class="icon-eye-open"></i> {{ t.translate('View') }}
                                </a>
                                <a href="{{ module_dir }}temp_files/{{ file.name }}" class="btn btn-default btn-xs" download="{{ file.name }}">
                                    <i class="icon-download"></i> {{ t.translate('Download') }}
                                </a>
                                <a href="{{ path('admin_updatestock_delete_uploaded_file', {'filename': file.name}) }}" class="btn btn-danger btn-xs" onclick="return confirm('{{ t.translate('Delete this file permanently?') }}');">
                                    <i class="icon-trash"></i> {{ t.translate('Delete') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">{{ t.translate('No files uploaded') }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <hr class="section-separator">

    <div class="panel">
        <div class="panel-heading">
             <i class="icon-cogs"></i> <strong>{{ t.translate('Analysis Configuration & Actions') }}</strong>
        </div>
        
        <div class="form-group">
            <label class="control-label col-lg-3"><strong>{{ t.translate('Inventory Scope') }}</strong></label>
            <div class="col-lg-9">
                <div class="radio">
                    <label>
                        <input type="radio" name="inventory_scope" value="single" {% if inventory_scope is defined and inventory_scope == 'single' %}checked{% elseif inventory_scope is not defined %}checked{% endif %}>
                        {{ t.translate('Current Shop Only') }}
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <input type="radio" name="inventory_scope" value="multi" {% if inventory_scope is defined and inventory_scope == 'multi' %}checked{% endif %}>
                        {{ t.translate('All Shops (Multistore)') }}
                        <span id="multistore-beta-label" class="label label-warning" style="margin-left: 6px; display:none;">Beta</span>
                    </label>
                    <p id="multistore-beta-warning" class="help-block text-danger" style="margin-left: 20px; display:none;">
                        {{ t.translate('Beta feature: not recommended for regular use. Please contact the administrator before using it.') }}
                    </p>
                </div>
            </div>
        </div>

        <div class="form-group">
             <label class="control-label col-lg-3"><strong>{{ t.translate('Options') }}</strong></label>
             <div class="col-lg-9">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" id="total-inventory-checkbox" name="total_inventory" value="1" {% if total_inventory is defined and total_inventory %}checked{% endif %}>
                         {{ t.translate('Total Inventory (Set missing products to 0)') }}
                    </label>
                    <p id="total-inventory-warning" class="help-block text-danger" style="display:none;">
                         {{ t.translate('Warning: Products not found in the uploaded files will be set to quantity 0.') }}
                    </p>
                </div>
             </div>
        </div>

        <div class="panel-footer">
            <button type="submit" name="submitDeleteFiles" class="btn btn-danger">
                <i class="process-icon-delete"></i> {{ t.translate('Delete Selected Files') }}
            </button>
            <button type="submit" name="submitPreview" class="btn btn-primary pull-right">
                <i class="process-icon-search"></i> {{ t.translate('Analyze & Preview') }}
            </button>
        </div>
    </div>
        
    {% if preview_mode is defined and preview_mode %}
        <div class="panel panel-info">
            <div class="panel-heading">
                <i class="icon-search"></i> {{ t.translate('Preview Results') }}
            </div>
            <div class="panel-body">
                <p><strong>{{ t.translate('Analysis Summary:') }}</strong></p>
                <ul>
                    <li><strong>{{ t.translate('Files:') }}</strong> {{ selected_files|join(', ') }}</li>
                    <li><strong>{{ t.translate('Scope:') }}</strong> {% if inventory_scope == 'multi' %}{{ t.translate('All Shops') }}{% else %}{{ t.translate('Current Shop Only') }}{% endif %}</li>
                    <li><strong>{{ t.translate('Type:') }}</strong> {% if total_inventory %}{{ t.translate('Total Inventory') }}{% else %}{{ t.translate('Partial Inventory') }}{% endif %}</li>
                    <li>{{ t.translate('Products to Update:') }} <span class="badge">{{ preview_stats.updated }}</span></li>
                    <li>{{ t.translate('Products to Zero (Total Inventory):') }} <span class="badge">{{ preview_stats.zeroed }}</span></li>
                    <li>{{ t.translate('Products to Disable:') }} <span class="badge">{{ preview_stats.disabled }}</span></li>
                    <li>{{ t.translate('Unknown EANs:') }} <span class="badge badge-warning">{{ preview_stats.unknown }}</span></li>
                </ul>
                <hr>
                <p><a href="{{ module_dir }}uploads/reports/{{ preview_report }}" class="btn btn-default" target="_blank"><i class="icon-download"></i> {{ t.translate('Download Detailed Preview CSV') }}</a></p>
                <div class="alert alert-warning">
                    {{ t.translate('Please review the preview CSV above content carefully. If everything looks correct, click "Confirm & Update" below.') }}
                </div>
            </div>
            {# Persist selections for final submission #}
            {% for file in selected_files %}
                <input type="hidden" name="confirmed_files[]" value="{{ file }}">
            {% endfor %}
            <div class="panel-footer">
                <button type="submit" name="submitCancel" class="btn btn-warning">
                    <i class="process-icon-cancel"></i> {{ t.translate('Cancel / Reset') }}
                </button>
                <button type="submit" name="submitRunInventory" class="btn btn-success pull-right" onclick="return confirm('{{ t.translate('This will Apply Changes to the database. Are you sure?') }}');">
                    <i class="process-icon-save"></i> {{ t.translate('Confirm & Update Stock') }}
                </button>
            </div>
        </div>
    {% endif %}
</form>

<hr class="section-separator">

{% if reports_generated is defined and reports_generated %}
<div class="panel">
    <div class="panel-heading">
        <i class="icon-file-text"></i> {{ t.translate('Execution Reports') }}
    </div>
    <div class="alert alert-success">
        {{ t.translate('Inventory processed successfully. Download reports below:') }}
    </div>
    <ul>
        {% if reports_generated.log %}
            <li><a href="{{ module_dir }}uploads/reports/{{ reports_generated.log }}" target="_blank">{{ t.translate('Inventory Log') }}</a></li>
        {% endif %}
        {% if reports_generated.zeroed %}
            <li><a href="{{ module_dir }}uploads/reports/{{ reports_generated.zeroed }}" target="_blank">{{ t.translate('Zeroed/Disabled Products') }}</a></li>
        {% endif %}
        {% if reports_generated.unknown %}
            <li><a href="{{ module_dir }}uploads/reports/{{ reports_generated.unknown }}" target="_blank">{{ t.translate('Unknown EANs') }}</a></li>
        {% endif %}
        {% if reports_generated.inconsistencies is defined and reports_generated.inconsistencies %}
            <li><a href="{{ module_dir }}uploads/reports/{{ reports_generated.inconsistencies }}" target="_blank" style="color:red; font-weight:bold;">{{ t.translate('Consistency Issues (Pending Fixes)') }}</a></li>
            <div style="margin-top: 10px;">
                <form action="{{ path('admin_updatestock_index') }}" method="post">
                    <button type="submit" name="submitApplyFixes" class="btn btn-warning" onclick="return confirm('{{ t.translate('Apply suggested fixes to database?') }}');">
                        <i class="icon-wrench"></i> {{ t.translate('Apply Suggested Fixes') }}
                    </button>
                </form>
            </div>
        {% endif %}
    </ul>
</div>
{% endif %}

<div class="panel">
    <div class="panel-heading">
        <i class="icon-file-text"></i> <strong>{{ t.translate('Report History') }}</strong>
        {% if available_reports is defined and available_reports %}
            <span class="badge">{{ available_reports|length }}</span>
        {% endif %}
    </div>
    {% if available_reports is defined and available_reports %}
        <form id="bulk-reports-form" action="{{ path('admin_updatestock_index') }}" method="post">
        <div style="max-height: 360px; overflow-y: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th width="40"><input type="checkbox" class="checkmeable-reports"></th>
                        <th>{{ t.translate('Type') }}</th>
                        <th>{{ t.translate('Filename') }}</th>
                        <th>{{ t.translate('Date') }}</th>
                        <th>{{ t.translate('Size') }}</th>
                        <th class="text-right">{{ t.translate('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for report in available_reports %}
                        <tr>
                            <td><input type="checkbox" name="selected_reports[]" value="{{ report.filename }}"></td>
                            <td>{{ t.translate(report.type) }}</td>
                            <td>{{ report.filename }}</td>
                            <td>{{ report.date }}</td>
                            <td>{{ report.size }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_updatestock_view_report', {'filename': report.filename}) }}" class="btn btn-default btn-xs" target="_blank">
                                    <i class="icon-eye-open"></i> {{ t.translate('View') }}
                                </a>
                                <a href="{{ module_dir }}uploads/reports/{{ report.filename }}" class="btn btn-default btn-xs" download="{{ report.filename }}">
                                    <i class="icon-download"></i> {{ t.translate('Download') }}
                                </a>
                                <a href="{{ path('admin_updatestock_delete_report', {'filename': report.filename}) }}" class="btn btn-danger btn-xs" onclick="return confirm('{{ t.translate('Delete this report permanently?') }}');">
                                    <i class="icon-trash"></i> {{ t.translate('Delete') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div style="padding: 10px 0 0 0;">
            <button type="submit" name="submitDeleteSelectedReports" class="btn btn-danger" onclick="return confirm('{{ t.translate('Delete selected reports permanently?') }}');">
                <i class="icon-trash"></i> {{ t.translate('Delete Selected Reports') }}
            </button>
        </div>
        </form>
    {% else %}
        <div class="alert alert-info">{{ t.translate('No reports available.') }}</div>
    {% endif %}
</div>

<hr class="section-separator">

<div class="panel">
    <div class="panel-heading">
        <i class="icon-time"></i> <strong>{{ t.translate('Backup History') }}</strong>
        {% if available_backups is defined and available_backups %}
            <span class="badge">{{ available_backups|length }}</span>
        {% endif %}
    </div>
    {% if available_backups is defined and available_backups %}
        <form id="bulk-backups-form" action="{{ path('admin_updatestock_index') }}" method="post">
        <div style="max-height: 360px; overflow-y: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th width="40"><input type="checkbox" class="checkmeable-backups"></th>
                        <th>{{ t.translate('Filename') }}</th>
                        <th>{{ t.translate('Date') }}</th>
                        <th>{{ t.translate('Size') }}</th>
                        <th class="text-right">{{ t.translate('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in available_backups %}
                        <tr>
                            <td><input type="checkbox" name="selected_backups[]" value="{{ backup.filename }}"></td>
                            <td>{{ backup.filename }}</td>
                            <td>{{ backup.date }}</td>
                            <td>{{ backup.size }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_updatestock_restore_backup', {'filename': backup.filename}) }}" class="btn btn-warning btn-xs" onclick="return confirm('{{ t.translate('RESTORE BACKUP? This will overwrite current stock data with this backup version.') }}');">
                                    <i class="icon-refresh"></i> {{ t.translate('Restore') }}
                                </a>
                                <a href="{{ path('admin_updatestock_delete_backup', {'filename': backup.filename}) }}" class="btn btn-danger btn-xs" onclick="return confirm('{{ t.translate('Delete this backup permanently?') }}');">
                                    <i class="icon-trash"></i> {{ t.translate('Delete') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div style="padding: 10px 0 0 0;">
            <button type="submit" name="submitDeleteSelectedBackups" class="btn btn-danger" onclick="return confirm('{{ t.translate('Delete selected backups permanently?') }}');">
                <i class="icon-trash"></i> {{ t.translate('Delete Selected Backups') }}
            </button>
        </div>
        </form>
    {% else %}
        <div class="alert alert-info">{{ t.translate('No backups available.') }}</div>
    {% endif %}
</div>

<hr class="section-separator">

<div class="panel">
    <div class="panel-heading">
        <i class="icon-terminal"></i> <strong>{{ t.translate('Live Logs') }}</strong>
    </div>
    <div class="form-horizontal">
        <div class="form-group row">
            <label class="control-label col-lg-2 col-md-2 col-sm-2">{{ t.translate('Show Last Lines') }}</label>
            <div class="col-lg-2 col-md-2 col-sm-4">
                <select id="log-lines-selector" class="form-control">
                    <option value="0">{{ t.translate('No logs') }}</option>
                    <option value="10">10</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <label class="control-label col-lg-2 col-md-2 col-sm-2">{{ t.translate('Log Level') }}</label>
            <div class="col-lg-2 col-md-2 col-sm-4">
                <select id="log-level-selector" class="form-control">
                    <option value="INFO">INFO (Default)</option>
                    <option value="DEBUG">DEBUG (All)</option>
                </select>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-12">
                <span id="log-status" class="help-block" style="margin-top:0;"></span>
            </div>
        </div>
    </div>
    
    <div id="log-container-wrapper" style="display:none; margin-top: 15px;">
        <pre id="log-viewer" style="background: #222; color: #0f0; padding: 10px; height: 300px; overflow-y: scroll; border-radius: 4px; font-family: monospace;"></pre>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const moduleVersion = "{{ module_version is defined ? module_version|e('js') : '' }}";
        const selector = document.getElementById('log-lines-selector');
        const levelSelector = document.getElementById('log-level-selector');
        const viewerWrapper = document.getElementById('log-container-wrapper');
        const viewer = document.getElementById('log-viewer');
        const status = document.getElementById('log-status');
        let refreshInterval = null;
        const logUrl = "{{ path('admin_updatestock_logs_get') }}";

        function appendVersionToPageTitle() {
            if (!moduleVersion || document.getElementById('updatestock-page-version')) {
                return;
            }

            const candidates = document.querySelectorAll('h1, .page-title, .title');
            candidates.forEach(title => {
                if (title.textContent.indexOf('Stock Update Inventory') === -1 || document.getElementById('updatestock-page-version')) {
                    return;
                }

                const version = document.createElement('small');
                version.id = 'updatestock-page-version';
                version.className = 'text-muted';
                version.style.fontSize = '12px';
                version.style.marginLeft = '8px';
                version.textContent = 'v' + moduleVersion;
                title.appendChild(version);
            });
        }

        appendVersionToPageTitle();

        // 1. Restore State from LocalStorage
        const savedLines = localStorage.getItem('updatestock_log_lines');
        const savedLevel = localStorage.getItem('updatestock_log_level');

        if (savedLevel) {
            levelSelector.value = savedLevel;
        }
        if (savedLines) {
            selector.value = savedLines;
            if (savedLines > 0) {
                viewerWrapper.style.display = 'block';
                startLogPolling();
            }
        }

        function fetchLogs() {
            const lines = selector.value;
            if (lines == 0) return;

            status.innerText = "{{ t.translate('Refreshing...') }}";

            // Check scroll position BEFORE updating content
            // Tolerance of 50px to consider "at bottom"
            const isAtBottom = (viewer.scrollHeight - viewer.scrollTop - viewer.clientHeight) < 50;

            fetch(logUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ lines: lines })
            })
            .then(response => response.json())
            .then(data => {
                if (data.log) {
                    const level = levelSelector.value;
                    const filtered = [];
                    let showCurrentBlock = true;
                    const logStartRegex = /^\[\d{4}-\d{2}-\d{2}/;

                    data.log.forEach(line => {
                        if (logStartRegex.test(line)) {
                            if (level === 'INFO' && line.includes('[DEBUG]')) {
                                showCurrentBlock = false;
                            } else {
                                showCurrentBlock = true;
                            }
                        }
                        if (showCurrentBlock) {
                            filtered.push(line);
                        }
                    });

                    viewer.innerText = filtered.join("\n");
                    
                    // Only auto-scroll if user was already at the bottom
                    if (isAtBottom) {
                        viewer.scrollTop = viewer.scrollHeight;
                    }
                }
                status.innerText = "{{ t.translate('Last update:') }} " + new Date().toLocaleTimeString();
            })
            .catch(error => {
                console.error('Error fetching logs:', error);
                status.innerText = "{{ t.translate('Error fetching logs') }}";
            });
        }

        function startLogPolling() {
            fetchLogs(); // Initial fetch
            if (refreshInterval) clearInterval(refreshInterval);
            refreshInterval = setInterval(fetchLogs, 5000);
        }

        selector.addEventListener('change', function() {
            const lines = this.value;
            localStorage.setItem('updatestock_log_lines', lines); // Save state
            
            if (lines > 0) {
                viewerWrapper.style.display = 'block';
                startLogPolling();
            } else {
                viewerWrapper.style.display = 'none';
                if (refreshInterval) clearInterval(refreshInterval);
                status.innerText = "";
            }
        });

        levelSelector.addEventListener('change', function() {
            localStorage.setItem('updatestock_log_level', this.value); // Save state
            // If logs are active, refresh immediately to show new level
            if (selector.value > 0) {
                fetchLogs();
            }
        });

        // Validation for File Selection
        const btnDelete = document.querySelector('button[name="submitDeleteFiles"]');
        const btnPreview = document.querySelector('button[name="submitPreview"]');

        function validateFileSelection(e) {
            const selected = document.querySelectorAll('input[name="selected_files[]"]:checked').length;
            if (selected === 0) {
                e.preventDefault();
                alert("{{ t.translate('Please select at least one file.') }}");
            }
        }

        if (btnDelete) btnDelete.addEventListener('click', validateFileSelection);
        if (btnPreview) btnPreview.addEventListener('click', validateFileSelection);

        // Select All Checkboxes
        const checkAll = document.querySelector('.checkmeable');
        if (checkAll) {
            checkAll.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('input[name="selected_files[]"]');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        const checkAllReports = document.querySelector('.checkmeable-reports');
        if (checkAllReports) {
            checkAllReports.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('input[name="selected_reports[]"]');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        const checkAllBackups = document.querySelector('.checkmeable-backups');
        if (checkAllBackups) {
            checkAllBackups.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('input[name="selected_backups[]"]');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        // Total Inventory Warning Toggle
        const totalCheckbox = document.getElementById('total-inventory-checkbox');
        const warningMsg = document.getElementById('total-inventory-warning');

        function toggleWarning() {
            if (totalCheckbox.checked) {
                warningMsg.style.display = 'block';
            } else {
                warningMsg.style.display = 'none';
            }
        }

        if (totalCheckbox && warningMsg) {
            totalCheckbox.addEventListener('change', toggleWarning);
            toggleWarning(); // Initialize on load
        }

        // Multistore Beta Warning Toggle
        const betaLabel = document.getElementById('multistore-beta-label');
        const betaWarning = document.getElementById('multistore-beta-warning');
        const scopeRadios = document.querySelectorAll('input[name="inventory_scope"]');

        function toggleMultistoreBeta() {
            const selectedScope = document.querySelector('input[name="inventory_scope"]:checked');
            const showBeta = selectedScope && selectedScope.value === 'multi';
            if (betaLabel) betaLabel.style.display = showBeta ? 'inline' : 'none';
            if (betaWarning) betaWarning.style.display = showBeta ? 'block' : 'none';
        }

        scopeRadios.forEach(radio => radio.addEventListener('change', toggleMultistoreBeta));
        toggleMultistoreBeta();
    });
</script>
{% endblock %}
